20.	Representative commands
BuildDatabase \
-name LB0111_db \
../00_genome/LB0111_final.fa

RepeatModeler \
-database LB0111_db \
-threads 56 \
-LTRStruct

21.	Genome repeat masking
RepeatMasker \
-pa 56 \
-lib ../01_repeatmodeler/LB0111_db-families.fa \
-gff \
-dir . \
../00_genome/LB0111_final.fa

22.	RNA-seq alignment
hisat2-build \
-p 56 \
genome.masked.fa \
LB0111_hisat2_index

hisat2 \
-p 56 \
--dta \
-x LB0111_hisat2_index \
-1 ERR12356292_1.fastq.gz \
-2 ERR12356292_2.fastq.gz | \
samtools sort \
-o ERR12356292.sorted.bam

*The same procedure was applied to dataset SRR10852993.


23.	Evidence-guided gene prediction
perl braker.pl \
--genome=input/LB0111_final.masked.fa \
--species=Leucocarbo_bransfieldensis_ETP \
--bam=ERR12356292.sorted.bam,SRR10852993.sorted.bam \
--prot_seq=input/Pcarbo_Garistotelis.nr99.proteins.faa \
--threads=56 \
--gff3

24.	Structural annotation completeness assessment
# Annotation completeness assessment
# One representative protein isoform per gene (longest isoform)

busco \
-i Augustus/augustus.longest_isoform.aa \
-l aves_odb10 \
-o busco_augustus_longest_isoform_aves \
-m proteins \
-c 80


Functional annotation

25.	eggNOG-mapper
emapper.py \
-i LB0111_GeneMarkETP_supported.proteins.faa \
-o LB0111_GeneMarkETP_eggnog \
-m diamond \
--cpu 56

26.	InterProScan
interproscan.sh \
-i LB0111_GeneMarkETP_supported.proteins.faa \
-f tsv,gff3 \
-cpu 56

