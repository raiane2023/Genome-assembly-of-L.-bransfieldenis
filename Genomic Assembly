10.	Telomeric repeat detection
import re
import csv

fasta = "../LB0111_ont_hic.p_ctg.fa"
window = 100000
min_repeats = 5

left_pattern = re.compile(r"(?:CCCTAA){" + str(min_repeats) + r",}")
right_pattern = re.compile(r"(?:TTAGGG){" + str(min_repeats) + r",}")

def read_fasta(path):
    name = None
    seq_parts = []

    with open(path) as f:
        for line in f:
            line = line.strip()

            if line.startswith(">"):
                if name is not None:
                    yield name, "".join(seq_parts)

                name = line[1:].split()[0]
                seq_parts = []
            else:
                seq_parts.append(line)

        if name is not None:
            yield name, "".join(seq_parts)

rows = []

for name, seq in read_fasta(fasta):
    seq = seq.upper()
    length = len(seq)

    left = seq[:min(window, length)]
    right = seq[-min(window, length):]

    left_matches = list(left_pattern.finditer(left))
    right_matches = list(right_pattern.finditer(right))

    left_tel = len(left_matches) > 0
    right_tel = len(right_matches) > 0

    left_max = max(
        [(m.end() - m.start()) // 6 for m in left_matches],
        default=0
    )

    right_max = max(
        [(m.end() - m.start()) // 6 for m in right_matches],
        default=0
    )

    if left_tel and right_tel:
        classification = "Two_telomeres"
    elif left_tel or right_tel:
        classification = "One_telomere"
    else:
        classification = "No_telomere"

    rows.append([
        name,
        length,
        left_max,
        right_max,
        "Yes" if left_tel else "No",
        "Yes" if right_tel else "No",
        classification
    ])

rows.sort(key=lambda x: x[1], reverse=True)

